# Appwrite Configuration
VITE_APPWRITE_DATABASE_ID=your_database_id
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your_project_id

# Whapi Configuration
VITE_WHAPI_API_URL=https://gate.whapi.cloud
VITE_WHAPI_TOKEN=your_whapi_token
VITE_WHAPI_WEBHOOK_URL=https://your-domain.com/webhook/botaconw

# Webhook para configuración del asistente ACO
VITE_CONFIG_WEBHOOK_URL=https://your-domain.com/webhook/configBot

# Optional: Base path for nginx deployment
# VITE_USE_BASE_PATH=true
